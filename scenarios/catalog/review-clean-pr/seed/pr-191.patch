+REGISTRIES = {
+    "com": RetryPolicy(retryable_errors=TRANSIENT + CONNECTION, max_attempts=4, backoff_seconds=0.5),
+    "net": RetryPolicy(retryable_errors=TRANSIENT + CONNECTION, max_attempts=4, backoff_seconds=0.5),
+    "org": RetryPolicy(retryable_errors=TRANSIENT, max_attempts=3, backoff_seconds=1.0),
+    # DENIC (.de) rejects a repeated command with the same transaction id and may
