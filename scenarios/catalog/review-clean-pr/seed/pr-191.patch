 from dataclasses import dataclass
 
 
@@ -7,16 +9,28 @@ from dataclasses import dataclass
 class RetryPolicy:
     retryable_errors: tuple[str, ...]
     max_attempts: int
+    backoff_seconds: float = 0.0
+
+    def retryable(self, code: str) -> bool:
+        return code in self.retryable_errors
+
 
+TRANSIENT = ("SERVER_BUSY", "RATE_LIMITED")
+CONNECTION = ("CONNECTION_RESET",)
 
-DEFAULT = RetryPolicy(retryable_errors=("SERVER_BUSY", "RATE_LIMITED"), max_attempts=3)
+DEFAULT = RetryPolicy(retryable_errors=TRANSIENT, max_attempts=3)
 
-# DENIC (.de) rejects a repeated command with the same transaction id and may
